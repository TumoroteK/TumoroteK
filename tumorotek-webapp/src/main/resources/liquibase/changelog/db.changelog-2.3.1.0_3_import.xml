    <!-- /!\ ce changeSet n'est pas compatible avec Oracle. A
    		 A noter qu'Oracle a introduit la notion d'IDENTITY (équivalent à l'auto incrément) dans la version 12c -->
    <changeSet id="updateTable_IMPORTATION_AUTO_INCREMENT" author="TK-538" runAlways="false" context="*">
        <comment>Passage de la gestion de IMPORTATION_ID en AUTO_INCREMENT</comment>
        <sql>
            ALTER TABLE IMPORTATION MODIFY IMPORTATION_ID INT(10) NOT NULL AUTO_INCREMENT;
        </sql>
    </changeSet>
    <changeSet id="updateTable_IMPORTATION_TYPE_CODE" author="TK-538" runAlways="false" context="*">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="IMPORTATION" columnName="TYPE_CODE" />
            </not>
        </preConditions>
        <comment>Ajout d'un champ pour gérer le type d''import fait</comment>
        <addColumn tableName="IMPORTATION">
            <column name="TYPE_CODE" type="VARCHAR(20)" defaultValue="NEW" remarks="les valeurs possibles sont NEW et MODIF_ANNO.">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>
    <!-- suppression de l'index sur  IMPORTATION (OBJET_ID, ENTITE_ID) pour le remplacer par  IMPORTATION (OBJET_ID, ENTITE_ID, TYPE_CODE) -->
	<changeSet id="drop_index_IMPORTATION_Objet_Entite" author="TK-538" runAlways="false" context="*">
        <preConditions onFail="MARK_RAN">
	    	<indexExists indexName="OBJET_ENTITE_IDX" tableName="IMPORTATION" />
    	</preConditions>
        <dropIndex indexName="OBJET_ENTITE_IDX" tableName="IMPORTATION"></dropIndex>
    </changeSet>
    <changeSet id="create_index_IMPORTATION_Objet_Entite_Type" author="TK-538" runAlways="false" context="*">
        <preConditions onFail="MARK_RAN">
	        <not>
	            <indexExists indexName="OBJET_ENTITE_TYPE_IDX" tableName="IMPORTATION" />
	        </not>
    	</preConditions>
        <createIndex indexName="OBJET_ENTITE_TYPE_IDX" tableName="IMPORTATION" unique="false">  
        	<column name="OBJET_ID"/>
        	<column name="ENTITE_ID"/>
        	<column name="TYPE_CODE"/>  
    	</createIndex>
    </changeSet>
       
</databaseChangeLog>