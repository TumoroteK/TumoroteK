            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM CHAMP_ENTITE
                WHERE NOM = 'Requalifiable' and ENTITE_ID=8
            </sqlCheck>
        </preConditions>
        <comment>Ajout du champ entite Requalifiable pour un produit dérivé</comment>
