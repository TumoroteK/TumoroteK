        <appender-ref ref="TumorotekFile"/>
    </logger> 
	-->	

    <logger name="fr.aphp.tumorotek.interfacage" additivity="false" level="ERROR">
        <appender-ref ref="InterfacageFile"/>
    </logger>
	
	
	<logger name="org.hibernate.type" additivity="false" level="ERROR">
        <appender-ref ref="TumorotekFile"/>
    </logger>
	<logger name="org.hibernate" additivity="false" level="ERROR">
        <appender-ref ref="TumorotekFile"/>
    </logger>


    <logger name="org.apache.camel" additivity="false" level="ERROR">
        <appender-ref ref="TumorotekFile"/>
    </logger>

    <root level="ERROR">
        <appender-ref ref="TumorotekFile"/>
    </root>
</configuration>