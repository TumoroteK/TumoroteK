			<Bloc>MSH</Bloc>
			<Emplacement>2</Emplacement>
		</Emetteur>
		<!-- emplacement par défaut. A vérifier avec les fichiers transmis. 
		     La valeur attendue doit correspondre au service défini dans la table EMETTEUR pour l'id défini ci-dessous -->
		<Service>
			<Bloc>MSH</Bloc>
			<Emplacement>4</Emplacement>
		</Service>
		<MappingXml>
			<!-- l'id ci-dessous doit correspondre au champ EMETTEUR_ID de la table EMETTEUR, pour l'émetteur correspondant à l'interfaçage -->
			<EmetteurId>4</EmetteurId>
			<XML>/home/mathieu/tomcat/conf/Catalina/localhost/sgl/diamic-mapping.xml</XML>
		</MappingXml>
	</BoiteFtp>
