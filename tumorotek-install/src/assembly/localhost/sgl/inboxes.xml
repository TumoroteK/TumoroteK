<?xml version="1.0" encoding="UTF-8"?>
<ConfigurationInterfacage>
	<BoiteFtp nom="DIAMIC">
		<Configuration>
			<SeparateurChamps>|</SeparateurChamps>
			<SeparateurComposants>^</SeparateurComposants>
			<SeparateurSousComposants>~</SeparateurSousComposants>
			<NumeroDossier>
				<BlocValue>SPM</BlocValue>
				<Key>4.1</Key>
			</NumeroDossier>
			<DateDossier>
				<BlocValue>MSH</BlocValue>
				<Key>6</Key>
			</DateDossier>
			<OperationDossier>
				<BlocValue>ORC</BlocValue>
				<Key>5</Key>
			</OperationDossier>
		</Configuration>
		<!-- emplacement par défaut. A vérifier avec les fichiers transmis. 
		     La valeur attendue doit correspondre au champ identification dans la table EMETTEUR pour l'id défini ci-dessous -->
